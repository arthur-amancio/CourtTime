leto: varchar(150)&lt;br&gt;NN rm_ou_rg: varchar(30)&lt;br&gt;NN categoria: varchar(10)&lt;br&gt;vinculo: varchar(20)&lt;br&gt;presenca: varchar(10)&lt;br&gt;FK presenca_registrada_por_id&lt;br&gt;adicionado_na_portaria: boolean&lt;br&gt;FK adicionado_por_id&lt;br&gt;presenca_registrada_em / adicionado_em&lt;/div&gt;" style="html=1;whiteSpace=wrap;swimlane;startSize=29;horizontal=1;rounded=0;fillColor=#DDF3F5;swimlaneFillColor=#FFFFFF;strokeColor=#0E7490;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="305" width="200" height="205" as="geometry"/></mxCell><mxCell id="documentos" value="&lt;b&gt;documentos_reserva&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;padding:4px&quot;&gt;PK id: bigint&lt;br&gt;FK NN reserva_id → reservas.id&lt;br&gt;UQ (reserva_id, versao)&lt;br&gt;NN versao / revisao_participantes: integer&lt;br&gt;UQ NN chave_armazenamento: varchar(80)&lt;br&gt;NN nome_original: varchar(255)&lt;br&gt;NN sha256: varchar(64)&lt;br&gt;NN tamanho_bytes: bigint&lt;br&gt;FK NN enviado_por_id → usuarios.id&lt;br&gt;NN enviado_em: timestamp&lt;/div&gt;" style="html=1;whiteSpace=wrap;swimlane;startSize=29;horizontal=1;rounded=0;fillColor=#DDF3F5;swimlaneFillColor=#FFFFFF;strokeColor=#0E7490;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="265" width="230" height="190" as="geometry"/></mxCell><mxCell id="conferencias" value="&lt;b&gt;conferencias_documento&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;padding:4px&quot;&gt;PK id: bigint&lt;br&gt;UQ FK NN documento_id&lt;br&gt;NN resultado: varchar(30)&lt;br&gt;justificativa: varchar(500)&lt;br&gt;assinatura_gov_br_conferida: boolean&lt;br&gt;FK NN conferido_por_id → usuarios.id&lt;br&gt;NN conferido_em: timestamp&lt;/div&gt;" style="html=1;whiteSpace=wrap;swimlane;startSize=29;horizontal=1;rounded=0;fillColor=#DDF3F5;swimlaneFillColor=#FFFFFF;strokeColor=#0E7490;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="265" width="230" height="170" as="geometry"/></mxCe