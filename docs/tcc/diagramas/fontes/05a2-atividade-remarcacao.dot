digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.55, fontname="Arial", fontsize=18];
node [fontname="Arial", fontsize=16, color="#222222", penwidth=1.2, margin="0.14,0.10", style="filled", fillcolor="white"];
edge [fontname="Arial", fontsize=13, color="#333333", arrowsize=0.75];
graph [nodesep=0.14, ranksep=0.14, newrank=true];
subgraph cluster_l0 { label="ALUNO"; style=solid; color="#777777";
a [shape=box, label="Escolher novo período\ne solicitar remarcação" style="rounded,filled"];
blank0_1 [shape=box, label="" style=invis width=0.4 height=0.02];
blank0_2 [shape=box, label="" style=invis width=0.4 height=0.02];
blank0_3 [shape=box, label="" style=invis width=0.4 height=0.02];
blank0_4 [shape=box, label="" style=invis width=0.4 height=0.02];
r [shape=box, label="Nova documentação (04a);\ncrédito após conferência\n(05b)" style="dashed,rounded"];
}
subgraph cluster_l1 { label="COURTTIME"; style=solid; color="#777777";
blank1_0 [shape=box, label="" style=invis width=0.4 height=0.02];
l [shape=box, label="Bloquear origem; conferir\ndono,\ncancelamento e sucessora" style="rounded,filled"];
v [shape=diamond, label="Origem e novo\nperíodo elegíveis?" ];
no [shape=box, label="Recusar sem criar reserva" style="rounded,filled"];
new [shape=box, label="Criar nova solicitação;\nremarcacao_de_id único;\ncópia opcional de\nparticipantes" style="rounded,filled"];
blank1_5 [shape=box, label="" style=invis width=0.4 height=0.02];
}
{rank=same;a;blank1_0;}
a -> blank1_0 [style=invis weight=100];
a -> blank0_1 [label="" style=invis weight=10];
blank1_0 -> l [label="" style=invis weight=10];
{rank=same;blank0_1;l;}
blank0_1 -> l [style=invis weight=100];
blank0_1 -> blank0_2 [label="" style=invis weight=10];
l -> v [label="" style=invis weight=10];
{rank=same;blank0_2;v;}
blank0_2 -> v [style=invis weight=100];
blank0_2 -> blank0_3 [label="" style=invis weight=10];
v -> no [label="" style=invis weight=10];
{rank=same;blank0_3;no;}
blank0_3 -> no [style=invis weight=100];
blank0_3 -> blank0_4 [label="" style=invis weight=10];
no -> new [label="" style=invis weight=10];
{rank=same;blank0_4;new;}
blank0_4 -> new [style=invis weight=100];
blank0_4 -> r [label="" style=invis weight=10];
new -> blank1_5 [label="" style=invis weight=10];
{rank=same;r;blank1_5;}
r -> blank1_5 [style=invis weight=100];
a -> l [label="" constraint=false];
l -> v [label="" constraint=false];
v -> no [label="[não]" constraint=false];
v -> new [label="[sim]" constraint=false];
new -> r [label="" constraint=false];

}